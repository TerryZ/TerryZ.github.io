---
import ProjectItem from '@components/Project.astro'

const vue3Projects = [
  { name: 'v-page', link: 'https://github.com/TerryZ/v-page' },
  { name: 'v-dropdown', link: 'https://github.com/TerryZ/v-dropdown' },
  { name: 'v-region', link: 'https://github.com/TerryZ/v-region' },
  { name: 'v-selectpage', link: 'https://github.com/TerryZ/v-selectpage' },
  { name: 'v-dialogs', link: 'https://github.com/TerryZ/v-dialogs' },
  { name: 'v-layouts', link: 'https://github.com/TerryZ/v-layouts' },
  { name: 'v-selectmenu', link: 'https://github.com/TerryZ/v-selectmenu' }
]
---

<div class="w-[50vw] h-screen flex flex-col justify-center items-start ps-8 bg-gray-50 gap-8">
  <div>
    <h3 class="font-bold">Vue 3 components</h3>
    <div class="flex flex-nowrap gap-4">
      {vue3Projects.map((project) => <ProjectItem name={project.name} link={project.link} />)}
    </div>
  </div>

  <div>
    <h3 class="font-bold">Vue 2 components</h3>
    <div>projects</div>
  </div>

  <div>
    <h3 class="font-bold">jQuery components</h3>
    <div>projects</div>
  </div>
</div>
