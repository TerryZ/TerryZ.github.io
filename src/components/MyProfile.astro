---
// import { Content as ProfileContent } from '@contents/profile.md'
import MyAvatar from '@/assets/avatar.png'
import ThemeSwitcher from './ThemeSwitcher.vue'
---

<div class="w-[50vw] h-screen flex justify-end items-center pe-8 dark:bg-gray-950/85">
  <div
    class="flex flex-col gap-6 font-mono dark:text-gray-200 [&_svg]:size-5 [&_svg]:text-gray-300 [&_svg]:dark:text-gray-500"
  >
    <div class="flex items-center gap-4 mb-4">
      <div
        class="size-20 rounded-full overflow-hidden shadow-lg shadow-gray-500 dark:shadow-gray-600"
      >
        <img src={MyAvatar.src} />
      </div>
      <div>
        <h3
          class="text-2xl font-semibold text-shadow-lg/15 dark:text-gray-50 dark:text-shadow-lg dark:text-shadow-gray-50"
        >
          TerryZ dev
        </h3>
      </div>
    </div>

    <div class="flex items-start gap-4">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        class="mt-1"
        ><g fill="none"
          ><path
            d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"
          ></path><path
            fill="currentColor"
            d="M6.315 6.176c-.25-.638-.24-1.367-.129-2.034a6.8 6.8 0 0 1 2.12 1.07c.28.214.647.283.989.18A9.3 9.3 0 0 1 12 5c.961 0 1.874.14 2.703.391c.342.104.709.034.988-.18a6.8 6.8 0 0 1 2.119-1.07c.111.667.12 1.396-.128 2.033c-.15.384-.075.826.208 1.14C18.614 8.117 19 9.04 19 10c0 2.114-1.97 4.187-5.134 4.818c-.792.158-1.101 1.155-.495 1.726c.389.366.629.882.629 1.456v3a1 1 0 0 0 2 0v-3c0-.57-.12-1.112-.334-1.603C18.683 15.35 21 12.993 21 10c0-1.347-.484-2.585-1.287-3.622c.21-.82.191-1.646.111-2.28c-.071-.568-.17-1.312-.57-1.756c-.595-.659-1.58-.271-2.28-.032a9 9 0 0 0-2.125 1.045A11.4 11.4 0 0 0 12 3c-.994 0-1.953.125-2.851.356a9 9 0 0 0-2.125-1.045c-.7-.24-1.686-.628-2.281.031c-.408.452-.493 1.137-.566 1.719l-.005.038c-.08.635-.098 1.462.112 2.283C3.484 7.418 3 8.654 3 10c0 2.992 2.317 5.35 5.334 6.397A4 4 0 0 0 8 17.98l-.168.034c-.717.099-1.176.01-1.488-.122c-.76-.322-1.152-1.133-1.63-1.753c-.298-.385-.732-.866-1.398-1.088a1 1 0 0 0-.632 1.898c.558.186.944 1.142 1.298 1.566c.373.448.869.916 1.58 1.218c.682.29 1.483.393 2.438.276V21a1 1 0 0 0 2 0v-3c0-.574.24-1.09.629-1.456c.607-.572.297-1.568-.495-1.726C6.969 14.187 5 12.114 5 10c0-.958.385-1.881 1.108-2.684c.283-.314.357-.756.207-1.14"
          ></path></g
        ></svg
      >
      <div class="flex flex-col gap-2">
        <div>
          <a href="https://github.com/terryz" class="">github.com/terryz</a>
        </div>
        <div>
          <a href="https://github.com/terryz" class="">
            <img alt="GitHub followers" src="https://img.shields.io/github/followers/terryz" />
          </a>
        </div>
      </div>
    </div>

    <div class="flex items-center gap-4">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" class=""
        ><g fill="none"
          ><path
            d="M12 2a8 8 0 0 1 8 8c0 6.5-8 12-8 12s-8-5.5-8-12a8 8 0 0 1 8-8m0 5a3 3 0 1 0 0 6a3 3 0 0 0 0-6"
            clip-rule="evenodd"></path><path
            stroke="currentColor"
            stroke-width="2"
            d="M20 10c0 6.5-8 12-8 12s-8-5.5-8-12a8 8 0 1 1 16 0Z"></path><path
            stroke="currentColor"
            stroke-width="2"
            d="M15 10a3 3 0 1 1-6 0a3 3 0 0 1 6 0Z"></path></g
        ></svg
      >
      Come from <strong>Fuzhou, China</strong>
    </div>

    <div class="flex items-start gap-4">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        class="mt-1"
        ><path
          fill="currentColor"
          d="M4 20q-.825 0-1.412-.587T2 18V6q0-.825.588-1.412T4 4h16q.825 0 1.413.588T22 6v12q0 .825-.587 1.413T20 20zm8-7L4 8v10h16V8zm0-2l8-5H4zM4 8V6v12z"
        ></path></svg
      >
      <div class="flex flex-col gap-1">
        <div>terry5@foxmail.com</div>
        <div>terryzeng5@gmail.com</div>
      </div>
    </div>

    <div class="flex items-center gap-4">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48"
        ><path
          fill="none"
          stroke="currentColor"
          stroke-linejoin="round"
          stroke-width="4"
          d="M18 6a6 6 0 0 0 12 0h5.455L42 15.818l-5.727 4.91V42H11.727V20.727L6 15.818L12.546 6z"
        ></path></svg
      >
      <ThemeSwitcher client:only="vue" />
    </div>
  </div>
</div>
