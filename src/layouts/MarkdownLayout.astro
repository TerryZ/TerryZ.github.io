---
// 引入 GitHub 样式
import 'github-markdown-css/github-markdown.css'
const { frontmatter } = Astro.props
---

<html>
  <head>
    <meta charset="utf-8" />
    <title>{frontmatter.title}</title>
    <style>
      .markdown-body {
        box-sizing: border-box;
        min-width: 200px;
        max-width: 980px;
        /* margin: 0 auto; */
        padding: 45px;
      }

      /* 适配深色模式（可选） */
      @media (max-width: 767px) {
        .markdown-body {
          padding: 15px;
        }
      }
    </style>
  </head>
  <body>
    <article class="markdown-body">
      <slot />
    </article>
  </body>
</html>
